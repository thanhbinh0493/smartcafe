@startuml III_uc_tong_quat
!pragma layout smetana
skinparam defaultFontName Arial
left to right direction
skinparam packageStyle rectangle
title Biểu đồ Use Case tổng quát

actor "Khách hàng" as KH
actor "Khách thành viên" as KTV
actor "Nhân viên" as NV
actor "Quản trị viên\n(Trụ sở)" as AD
actor "Quản lý\nchi nhánh" as QL
actor "Thu ngân" as TN
actor "Pha chế" as PC
actor "Dịch vụ\nthời tiết" as WEA <<system>>

KTV -|> KH
AD -|> NV
QL -|> NV
TN -|> NV
PC -|> NV

rectangle "Hệ thống SmartCafe - quản lý chuỗi cà phê thông minh" {
  package "Phân hệ 2: QR Order" {
    usecase "Gọi món qua QR" as UC_QR
    usecase "Theo dõi trạng thái đơn" as UC_TRACK
    usecase "Xác thực SĐT (OTP)\n& xem điểm" as UC_MEM
  }
  package "Phân hệ 3: AI" {
    usecase "Gợi ý món thông minh" as UC_AI
  }
  package "Phân hệ 1: Quản trị" {
    usecase "Đăng nhập" as UC_LOGIN
    usecase "Quản lý thực đơn chung" as UC_MENU
    usecase "Quản lý chi nhánh & nhân viên" as UC_BRANCH
    usecase "Quản lý khuyến mãi" as UC_PROMO
    usecase "Cấu hình chi nhánh\n(menu, bàn)" as UC_CFG
    usecase "Xử lý hàng đợi pha chế\n& giao đồ" as UC_ORDER
    usecase "Hỗ trợ khách hàng\n(tra cứu, hủy & hoàn tiền)" as UC_SUPPORT
    usecase "Xem dashboard bán hàng" as UC_REPORT
    usecase "Tổng hợp báo cáo ngày\n(tự động)" as UC_DAILY
  }
}

KH --> UC_QR
KH --> UC_TRACK
KTV --> UC_MEM
UC_QR ..> UC_AI : <<include>>
UC_AI --> WEA

NV --> UC_LOGIN
AD --> UC_MENU
AD --> UC_BRANCH
AD --> UC_PROMO
AD --> UC_REPORT
QL --> UC_CFG
QL --> UC_REPORT
UC_REPORT ..> UC_DAILY : <<include>>
PC --> UC_ORDER
TN --> UC_SUPPORT
@enduml
