# Sao chép thành .env rồi sửa nếu cần: copy .env.example .env
POSTGRES_USER=smartcafe
POSTGRES_PASSWORD=smartcafe
POSTGRES_DB=smartcafe

# Khóa ký JWT nhân viên / khách – BẮT BUỘC đổi khi demo ngoài máy cá nhân
JWT_SECRET=change-me-please-0123456789abcdef
STAFF_TOKEN_HOURS=8
CUSTOMER_TOKEN_MINUTES=60

# OTP giả lập (D12): bật DEMO thì mã hiện ở khung [DEMO] trên điện thoại khách.
# Tắt DEMO thì xem mã trong log: docker compose logs backend | findstr "Mock SMS"
OTP_DEMO_MODE=true
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
# 1 điểm = 100đ (D15)
POINT_VALUE_VND=100

# Món tạo trong N ngày gần nhất được gắn nhãn "MỚI"
NEW_ITEM_DAYS=30

# Nạp dữ liệu mẫu khi backend khởi động lần đầu (chỉ nạp nếu CSDL còn trống)
SEED_ON_START=true

# Mật khẩu chung của các tài khoản nhân viên mẫu
SEED_STAFF_PASSWORD=smartcafe123

# Địa chỉ khách mở khi quét QR, được in vào ảnh QR bàn (A06). Khi demo bằng điện thoại thật,
# đổi thành IP Wi-Fi của laptop, VD http://192.168.1.10:8080 (xem bằng lệnh ipconfig)
PUBLIC_BASE_URL=http://localhost:8080
